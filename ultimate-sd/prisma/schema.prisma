  datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  
  // User preferences for recommendations
  targetCompanies      String[] @default([])
  preferredDifficulty   String[] @default([])
  focusAreas           String[] @default([])
  onboardingCompleted  Boolean  @default(false)
  
  // User stats
  xp                   Int      @default(0)
  level                Int      @default(1)
  streak               Int      @default(0)
  completedProblems    Int      @default(0)
  lastPracticeAt       DateTime?

  // Subscription
  planType             String    @default("free") // "free" | "platform" | "ai"
  planExpiresAt        DateTime?
  planActivatedAt      DateTime?
  aiCredits            Int       @default(0)
  aiCreditsResetAt     DateTime?

  // BYOK (stored server-side; never returned to client)
  geminiApiKey         String?
  xaiApiKey            String?
  openaiApiKey         String?
  anthropicApiKey      String?
  azureOpenaiApiKey    String?
  azureOpenaiEndpoint  String?
  awsBedrockRegion     String?
  awsBedrockAccessKey  String?
  awsBedrockSecretKey  String?
  ollamaEndpoint       String?
  ollamaModel          String?
  preferredProvider    String    @default("gemini")
  
  // Relations
  problemProgress      ProblemProgress[]
  stepSubmissions      StepSubmission[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model ProblemProgress {
  id                String   @id @default(cuid())
  userId            String
  problemId         String
  status            String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | REVIEW_NEEDED | COMPLETED
  attempts          Int      @default(0)
  lastScore         Int?
  currentStep       String?
  startedAt         DateTime?
  lastAttemptAt     DateTime?
  
  // Timer State 
  isTimerRunning    Boolean  @default(true)
  lastPausedAt      DateTime?
  totalPausedSeconds Int     @default(0)

  nextRepetitionDate DateTime?

  // Progress Tracking
  completedStepIds  String[] @default([])
  sessionState      Json?
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime? @updatedAt
  
  @@unique([userId, problemId], name: "userId_problemId")
  @@index([userId])
  @@index([problemId])
}

model StepSubmission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  stepId    String   // e.g. "requirements-0"
  
  content   String   @db.Text
  feedback  String?  @db.Text // JSON string of feedback
  score     Int?
  isPassing Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, problemId, stepId])
}
