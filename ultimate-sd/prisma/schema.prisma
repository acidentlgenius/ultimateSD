datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW_NEEDED
  COMPLETED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum LaunchOfferKind {
  PLATFORM_LAUNCH
  AI_GIVEAWAY
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  accounts      Account[]
  sessions      Session[]
  
  // User preferences for recommendations
  targetCompanies      String[] @default([])
  preferredDifficulty   String[] @default([])
  focusAreas           String[] @default([])
  onboardingCompleted  Boolean  @default(false)
  
  // User stats
  xp                   Int      @default(0)
  level                Int      @default(1)
  streak               Int      @default(0)
  completedProblems    Int      @default(0)
  lastPracticeAt       DateTime?

  // Subscription
  planType             String    @default("free") // "free" | "platform" | "ai"
  planExpiresAt        DateTime?
  planActivatedAt      DateTime?
  aiCredits            Int       @default(0)
  aiCreditsResetAt     DateTime?

  // BYOK (stored server-side; never returned to client)
  geminiApiKey         String?
  xaiApiKey            String?
  openaiApiKey         String?
  anthropicApiKey      String?
  azureOpenaiApiKey    String?
  azureOpenaiEndpoint  String?
  awsBedrockRegion     String?
  awsBedrockAccessKey  String?
  awsBedrockSecretKey  String?
  ollamaEndpoint       String?
  ollamaModel          String?
  preferredProvider    String    @default("gemini")
  
  // Relations
  problemProgress         ProblemProgress[]
  stepSubmissions         StepSubmission[]
  practiceSessions        PracticeSession[]
  launchOfferRedemption   LaunchOfferRedemption?
  launchOfferEntry        LaunchOfferEntry?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LaunchOfferRedemption {
  id        String          @id @default(cuid())
  userId    String          @unique
  kind      LaunchOfferKind
  grantedAt DateTime        @default(now())
  expiresAt DateTime
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind])
}

model LaunchOfferEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  enteredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model PracticeSession {
  id                 String        @id @default(cuid())
  userId             String
  problemId          String
  status             SessionStatus @default(ACTIVE)
  attemptNumber      Int
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  finalScore         Int?
  diagramSnapshot    Json?
  isTimerRunning     Boolean       @default(true)
  lastPausedAt       DateTime?
  totalPausedSeconds Int           @default(0)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions  StepSubmission[]
  activeFor    ProblemProgress?

  @@index([userId, problemId])
  @@index([userId, status])
}

model ProblemProgress {
  id                String         @id @default(cuid())
  userId            String
  problemId         String
  status            ProgressStatus @default(NOT_STARTED)
  progressPercent   Int            @default(0)
  totalAttempts     Int            @default(0)
  bestScore         Int?
  activeSessionId   String?        @unique
  lastScore         Int?
  currentStep       String?
  startedAt         DateTime?
  lastAttemptAt     DateTime?

  nextRepetitionDate DateTime?

  // Progress Tracking
  completedStepIds  String[] @default([])

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSession     PracticeSession? @relation(fields: [activeSessionId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([userId, problemId], name: "userId_problemId")
  @@index([userId])
  @@index([problemId])
}

model StepSubmission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  sessionId String
  stepId    String   // e.g. "requirements-0"
  phase     String   // e.g. "requirements", "hld", "lld", "tradeoffs", "scalability"
  
  content   String   @db.Text
  feedback  String?  @db.Text // JSON string of feedback
  score     Int?
  isPassing Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   PracticeSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([userId, problemId, stepId])
  @@index([sessionId])
}
